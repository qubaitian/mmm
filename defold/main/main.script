local Colyseus = require 'colyseus.sdk'
local Input = require 'main.player_input'
local Arena = require 'main.arena'

local CHARACTERS = { [0] = 'green_character', 'red_character', 'yellow_character', 'purple_character' }
local ACTIONS = {}
for _, name in ipairs({ 'up', 'down', 'left', 'right', 'arrow_up', 'arrow_down', 'arrow_left', 'arrow_right' }) do
	ACTIONS[hash(name)] = name
end

local function status(text)
	msg.post('hud#gui', 'status', { text = text })
end

local function send_input(self)
	if not self.room then return end
	local x, y = self.input:direction()
	if x ~= self.last_x or y ~= self.last_y then
		self.room:send('move', { x = x, y = y })
		self.last_x, self.last_y = x, y
	end
end

function on_message(self, message_id, message)
	if message_id == hash('stick') then
		self.input:set_stick(message.x, message.y)
	end
end

local function update_count(self)
	local count = 0
	for _ in pairs(self.players) do count = count + 1 end
	msg.post('hud#gui', 'players', { count = count })
end

local function clear_players(self)
	for _, player in pairs(self.players) do go.delete(player.id) end
	self.players = {}
	msg.post('hud#gui', 'local_player', { visible = false })
	update_count(self)
end

local function bind_room(self, room)
	local callbacks = Colyseus.callbacks(room)
	callbacks:on_add('players', function(player, key)
		if not self.arena_ready then
			Arena.build(room.state.tiles, room.state.tileSize)
			self.arena_ready = true
		end
		local id = factory.create('#character_factory', vmath.vector3(player.x, player.y, 0))
		sprite.play_flipbook(msg.url(nil, id, 'sprite'), CHARACTERS[player.color] or CHARACTERS[0])
		self.players[key] = { id = id, x = player.x, y = player.y }
		callbacks:listen(player, 'x', function(value)
			if self.players[key] then self.players[key].x = value end
		end)
		callbacks:listen(player, 'y', function(value)
			if self.players[key] then self.players[key].y = value end
		end)
		if key == room.session_id then
			go.set_position(vmath.vector3(player.x, player.y, 0), 'camera')
			msg.post('hud#gui', 'local_player', { visible = true })
		end
		update_count(self)
	end)
	callbacks:on_remove('players', function(_, key)
		local player = self.players[key]
		if player then go.delete(player.id) end
		self.players[key] = nil
		update_count(self)
	end)
	room:on('leave', function()
		self.room = nil
		self.input:clear()
		clear_players(self)
		status('Disconnected - restart to join')
	end)
	room:on('error', function()
		status('Connection error - restart to join')
	end)
end

local function server_url()
	local url = sys.get_config_string('network.server', 'ws://192.168.110.229:2567')
	if html5 then
		local override = html5.run("new URLSearchParams(window.location.search).get('server') || ''")
		if override and override ~= '' then return override end
	end
	return url
end

function init(self)
	msg.post('.', 'acquire_input_focus')
	msg.post('camera#camera', 'acquire_camera_focus')
	self.input = Input.new()
	self.players = {}
	self.last_x, self.last_y = nil, nil
	self.arena_ready = false
	window.set_listener(function(_, event)
		if event == window.WINDOW_EVENT_FOCUS_LOST then
			self.input:clear()
			msg.post('hud#gui', 'keys_clear')
			send_input(self)
		end
	end)
	local url = server_url()
	print('Connecting to ' .. url)
	self.client = Colyseus.Client(url)
	self.client:join_or_create('movement', function(err, room)
		if err then
			status('Cannot connect - start the server and restart')
			print('Connection error: ' .. tostring(err))
			return
		end
		self.room = room
		room.reconnection.enabled = false
		print('Joined room: ' .. room.room_id .. ' as ' .. room.session_id)
		bind_room(self, room)
		status('Connected')
	end)
end

function update(self, dt)
	if not self.room then return end
	send_input(self)
	local blend = 1 - math.exp(-20 * dt)
	for _, player in pairs(self.players) do
		local position = go.get_position(player.id)
		position.x = position.x + (player.x - position.x) * blend
		position.y = position.y + (player.y - position.y) * blend
		go.set_position(position, player.id)
	end
	local player = self.players[self.room.session_id]
	if player then
		go.set_position(go.get_position(player.id), 'camera')
	end
end

function on_input(self, action_id, action)
	local name = ACTIONS[action_id]
	if name and (action.pressed or action.released) then
		self.input:set(name, not action.released)
		msg.post('hud#gui', 'key', { name = name, pressed = not action.released })
	end
end

function final(self)
	window.set_listener(nil)
	if self.room then self.room:leave() end
end
