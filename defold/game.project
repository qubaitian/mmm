[project]
title = mmm
version = 1.0.1
dependencies#0 = https://github.com/colyseus/colyseus-defold/archive/0.17.zip
dependencies#1 = https://github.com/defold/extension-websocket/archive/4.2.1.zip

[display]
width = 720
height = 1280
high_dpi = 1

[input]
game_binding = /input/game.input_bindingc

[bootstrap]
main_collection = /main/main.collectionc
render = /render/game.renderc

[android]
package = com.mmm.app
version_code = 10001
orientation = portrait
manifest = /manifests/android/AndroidManifest.xml

[html5]
scale_mode = fit

[network]
server = ws://192.168.110.229:2567

[library]
include_dirs = colyseus



[sprite]
max_count = 1024

[collection]
max_instances = 1024

[render]
clear_color_red = 0.08
clear_color_green = 0.10
clear_color_blue = 0.12
